<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      alignment="TOP_CENTER" fx:controller="com.PhysicalED.gui.ClassStudentsController">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="⬅ Torna alle classi" onAction="#handleBackToClasses" />
        <Label fx:id="lblTitolo" text="Studenti" style="-fx-font-size: 16;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Aggiorna" onAction="#handleAggiorna" />
    </HBox>

    <FlowPane hgap="10" vgap="8" prefWrapLength="760">
        <Label text="Nome:"/>
        <TextField fx:id="txtNome" promptText="Mario" prefColumnCount="12"/>

        <Label text="Cognome:"/>
        <TextField fx:id="txtCognome" promptText="Rossi" prefColumnCount="12"/>

        <Label text="Genere:"/>
        <ComboBox fx:id="comboGenere" prefWidth="120"/>

        <Button text="Aggiungi" onAction="#handleAggiungiStudente"/>
    </FlowPane>

    <TableView fx:id="tblStudenti" prefHeight="380" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="160"/>
            <TableColumn fx:id="colCognome" text="Cognome" prefWidth="200"/>
            <TableColumn fx:id="colGenere" text="Genere" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Rimuovi selezionato" onAction="#handleRimuoviStudente"/>
        <Label fx:id="lblEsito" style="-fx-text-fill: #00796B;"/>
    </HBox>
</VBox>

