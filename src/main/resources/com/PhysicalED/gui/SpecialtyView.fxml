<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      alignment="TOP_CENTER" fx:controller="com.PhysicalED.gui.SpecialtyController">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="⬅ Torna a Sport" onAction="#handleBackToSport" />
        <Label text="Specialità" style="-fx-font-size: 16;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblEsito" style="-fx-text-fill: #00796B;"/>
    </HBox>

    <FlowPane hgap="10" vgap="8" prefWrapLength="900">
        <Label text="Classe:"/>
        <ComboBox fx:id="comboClasse" prefWidth="140"/>

        <Label text="Sport:"/>
        <ComboBox fx:id="comboSport" prefWidth="180"/>

        <Label text="Data:"/>
        <DatePicker fx:id="dpData"/>

        <Label text="Descrizione:"/>
        <TextField fx:id="txtDescrizione" promptText="Salto in lungo" prefColumnCount="18"/>

        <Button text="Aggiungi" onAction="#handleAggiungi"/>
    </FlowPane>

    <TableView fx:id="tblSpecialita" prefHeight="380" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDescrizione" text="Descrizione" prefWidth="240"/>
            <TableColumn fx:id="colClasse" text="Classe" prefWidth="120"/>
            <TableColumn fx:id="colSport" text="Sport" prefWidth="160"/>
            <TableColumn fx:id="colData" text="Data" prefWidth="120"/>
        </columns>
    </TableView>

    <Button text="Rimuovi selezionato" onAction="#handleRimuovi"/>
</VBox>
