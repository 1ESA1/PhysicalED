<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      alignment="TOP_CENTER" fx:controller="com.PhysicalED.gui.ClassSectionController">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label text="Gestione Classi" style="-fx-font-size: 16;" />

    <FlowPane hgap="10" vgap="8" prefWrapLength="760">
        <Label text="Classe:"/>
        <TextField fx:id="txtNomeClasse" promptText="1A" prefColumnCount="10"/>

        <Label text="Anno:"/>
        <ComboBox fx:id="comboAnno" prefWidth="160"/>

        <Button text="Aggiungi" onAction="#handleAggiungiClasse"/>
    </FlowPane>

    <Label text="Suggerimento: fai doppio click su una classe per vedere gli studenti." style="-fx-text-fill: #546E7A;" />

    <TableView fx:id="tblClassi" prefHeight="380" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" text="Classe" prefWidth="160"/>
            <TableColumn fx:id="colAnno" text="Anno" prefWidth="220"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Rimuovi selezionata" onAction="#handleRimuoviClasse"/>
        <Label fx:id="lblEsito" style="-fx-text-fill: #00796B;"/>
    </HBox>
</VBox>
