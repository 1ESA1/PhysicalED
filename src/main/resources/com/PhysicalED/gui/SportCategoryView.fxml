<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      alignment="TOP_CENTER" fx:controller="com.PhysicalED.gui.SportCategoryController">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label text="Categorie Sport" style="-fx-font-size: 16;" />

    <FlowPane hgap="10" vgap="8" prefWrapLength="760">
        <Label text="Descrizione:"/>
        <TextField fx:id="txtDescrizione" promptText="Atletica" prefColumnCount="16"/>
        <Button text="Aggiungi" onAction="#handleAggiungi"/>
    </FlowPane>

    <TableView fx:id="tblSport" prefHeight="380" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDescrizione" text="Sport" prefWidth="280"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Rimuovi selezionato" onAction="#handleRimuovi"/>
        <Label fx:id="lblEsito" style="-fx-text-fill: #00796B;"/>
    </HBox>
</VBox>
