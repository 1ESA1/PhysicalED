<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="PhysicalEDPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.PhysicalED.model.SchoolYear</class>
        <class>com.PhysicalED.model.ClassSection</class>
        <class>com.PhysicalED.model.Student</class>
        <class>com.PhysicalED.model.SportCategory</class>
        <class>com.PhysicalED.model.SpecialtyEntity</class>
        <class>com.PhysicalED.model.Score</class>
        <class>com.PhysicalED.model.GradingScale</class>

        <properties>
            <!-- JDBC (SQLite) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:physicaled.db"/>

            <!-- Dialect Hibernate per SQLite (Hibernate 6 community dialects) -->
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>

            <!-- RESET dev: schema sempre pulito -->
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.hbm2ddl.drop_db" value="true"/>

            <!-- Logging SQL (abilita solo se serve) -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>

</persistence>